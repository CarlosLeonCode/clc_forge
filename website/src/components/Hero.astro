---
import { ui } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';
---

<section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- LEFT COLUMN: Value Proposition & Commands -->
      <div class="lg:col-span-6 space-y-6 text-left">
        
        <!-- Status badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-semibold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          {t['hero.badge']}
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.1]">
          {isEs ? (
            <>
              Eliminá el código descontrolado <span class="text-emerald-600">antes</span> de que llegue a producción.
            </>
          ) : (
            <>
              Eliminate uncontrolled code <span class="text-emerald-600">before</span> it reaches production.
            </>
          )}
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          {t['hero.description']}
        </p>

        <!-- Command Card & Quickstart -->
        <div class="p-4 rounded-xl bg-slate-900 text-white shadow-xl shadow-slate-900/10 border border-slate-800 space-y-3">
          <div class="flex items-center justify-between text-xs text-slate-400 font-mono pb-2 border-b border-slate-800">
            <span>{t['hero.cmdCardTitle']}</span>
            <span class="text-emerald-400">{t['hero.cmdCardTag']}</span>
          </div>
          <div class="flex items-center justify-between gap-3 font-mono text-sm">
            <div class="flex items-center gap-2 overflow-x-auto">
              <span class="text-emerald-400 select-none">$</span>
              <span class="text-slate-100 select-all font-semibold">npx clckernel start</span>
            </div>
            <button 
              type="button"
              onclick="navigator.clipboard.writeText('npx clckernel start'); const el=this.querySelector('.copy-text'); el.textContent='Copied!'; setTimeout(()=>el.textContent='Copy', 2000)" 
              class="flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-slate-800 hover:bg-slate-700 text-xs font-sans font-medium text-slate-200 transition-colors shrink-0"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-text">Copy</span>
            </button>
          </div>
        </div>

        <!-- Pillar Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
          <div class="flex items-center gap-2 text-xs font-medium text-slate-700">
            <svg class="text-emerald-600 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t['hero.pillar1']}</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-medium text-slate-700">
            <svg class="text-emerald-600 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t['hero.pillar2']}</span>
          </div>
          <div class="flex items-center gap-2 text-xs font-medium text-slate-700">
            <svg class="text-emerald-600 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{t['hero.pillar3']}</span>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: Dual-Mode Interactive Terminal -->
      <div class="lg:col-span-6">
        <div class="rounded-xl terminal-window overflow-hidden border border-slate-800 shadow-2xl">
          
          <!-- Terminal Header & Tabs -->
          <div class="bg-[#0b1120] px-4 py-2.5 border-b border-slate-800/80 flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
              <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
              <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
            </div>

            <!-- Tab Switcher -->
            <div class="flex items-center bg-slate-900/90 p-0.5 rounded-lg border border-slate-800 text-[11px] font-mono">
              <button 
                id="tab-cli-btn"
                type="button"
                onclick="switchHeroTab('cli')"
                class="px-2.5 py-1 rounded-md transition-all font-semibold bg-slate-800 text-emerald-400 shadow-xs"
              >
                {t['hero.tabCli']}
              </button>
              <button 
                id="tab-agent-btn"
                type="button"
                onclick="switchHeroTab('agent')"
                class="px-2.5 py-1 rounded-md transition-all text-slate-400 hover:text-white"
              >
                {t['hero.tabAgent']}
              </button>
            </div>
          </div>

          <!-- VIEW 1: Terminal CLI Flow -->
          <div id="view-cli" class="p-5 font-mono text-xs text-slate-300 space-y-3 bg-[#070b14] min-h-[410px] overflow-y-auto">
            <div class="flex items-center gap-2 text-slate-400">
              <span class="text-emerald-400">developer@workspace:~$</span>
              <span class="text-white font-semibold">npx clckernel start</span>
            </div>
            
            <div class="text-slate-400 pl-3 border-l border-emerald-500/40 space-y-1 text-[11px]">
              <div><span class="text-cyan-400">⚡</span> {isEs ? 'Stack detectado: Next.js + FastAPI (Polyglot)' : 'Stack detected: Next.js + FastAPI (Polyglot)'}</div>
              <div><span class="text-emerald-400">✔</span> {isEs ? 'Directorio SDD inicializado (sdds/)' : 'Local SDD directory initialized (sdds/)'}</div>
              <div><span class="text-emerald-400">✔</span> {isEs ? 'Gobernanza activada en .clckernel.yaml' : 'Governance activated in .clckernel.yaml'}</div>
              <div><span class="text-emerald-400">✔</span> {isEs ? 'Hooks de pre-commit vinculados con éxito' : 'Pre-commit git hooks linked successfully'}</div>
            </div>

            <div class="flex items-center gap-2 text-slate-400 pt-2">
              <span class="text-emerald-400">developer@workspace:~$</span>
              <span class="text-white font-semibold">node tools/audit.js</span>
            </div>

            <div class="bg-slate-900/90 rounded-lg p-3 border border-slate-800 space-y-2 text-[11px]">
              <div class="text-slate-400 font-semibold flex items-center justify-between">
                <span>🛡️ {isEs ? 'COMPUERTA AST DETERMINISTA' : 'DETERMINISTIC AST AUDIT GATE'}</span>
                <span class="text-emerald-400 text-[10px]">HARD GATE</span>
              </div>
              
              <div class="space-y-1 text-slate-300">
                <div class="flex items-center justify-between">
                  <span class="flex items-center gap-1.5"><span class="text-emerald-400">✔</span> scan_secrets</span>
                  <span class="text-emerald-400 text-[10px]">{isEs ? '0 fugas de claves' : '0 leaks detected'}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="flex items-center gap-1.5"><span class="text-emerald-400">✔</span> check_architecture</span>
                  <span class="text-emerald-400 text-[10px]">{isEs ? 'Aislamiento de capas AST intacto' : 'Layer isolation verified'}</span>
                </div>
                <div class="flex items-center justify-between">
                  <span class="flex items-center gap-1.5"><span class="text-emerald-400">✔</span> check_db_efficiency</span>
                  <span class="text-emerald-400 text-[10px]">{isEs ? 'Cero consultas N+1 en bucles' : 'No N+1 queries detected'}</span>
                </div>
              </div>
            </div>

            <div class="pt-2 flex items-center justify-between text-emerald-400 font-bold border-t border-slate-800 text-xs">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                {isEs ? '[APROBADO] Commit autorizado en git' : '[PASSED] Pre-commit authorization granted'}
              </span>
              <span class="text-slate-400 font-mono text-[10px]">Exit Code: 0</span>
            </div>
          </div>

          <!-- VIEW 2: Inside LLM Agent (Claude Code / Open Code / Cursor) -->
          <div id="view-agent" class="hidden p-5 font-mono text-xs text-slate-300 space-y-3 bg-[#070b14] min-h-[410px] overflow-y-auto">
            <div class="flex items-center justify-between text-[11px] text-cyan-400 font-semibold pb-1 border-b border-slate-800">
              <span>🤖 AI AGENT (Claude Code / Open Code / AGY)</span>
              <span class="text-slate-500 text-[10px]">RULE #0 ENFORCED</span>
            </div>

            <!-- Agent Step 1 -->
            <div class="space-y-1 text-[11px]">
              <div class="text-slate-400 flex items-center gap-1.5">
                <span class="text-purple-400">1. Reading Law:</span>
                <span class="text-slate-200">Loaded AGENTS.md & .clckernel.yaml</span>
              </div>
              <div class="text-slate-500 pl-3">↳ {isEs ? 'Prohibido modificar código sin ciclo TDD' : 'Direct code modification strictly forbidden without harness'}</div>
            </div>

            <!-- Agent Step 2 -->
            <div class="space-y-1 text-[11px]">
              <div class="text-slate-400 flex items-center gap-1.5">
                <span class="text-purple-400">2. Planning SDD:</span>
                <span class="text-slate-200">Created sdds/auth-fix/spec.md</span>
              </div>
              <div class="text-slate-500 pl-3">↳ {isEs ? 'Scope delimitado a src/auth/ y test/auth.test.js' : 'Scope bounded strictly to src/auth/ & test/auth.test.js'}</div>
            </div>

            <!-- Agent Step 3 -->
            <div class="space-y-1 text-[11px]">
              <div class="text-slate-400 flex items-center gap-1.5">
                <span class="text-rose-400">3. TDD Red Phase:</span>
                <span class="text-slate-200">Executing pytest / vitest</span>
              </div>
              <div class="text-rose-400 pl-3">↳ ✖ 1 failed (Defect reproduced deterministically)</div>
            </div>

            <!-- Agent Step 4 -->
            <div class="space-y-1 text-[11px]">
              <div class="text-slate-400 flex items-center gap-1.5">
                <span class="text-emerald-400">4. Clean Green Phase:</span>
                <span class="text-slate-200">Implemented feature in Domain Layer</span>
              </div>
              <div class="text-emerald-400 pl-3">↳ ✔ All 24 tests passing (Layer boundaries respected)</div>
            </div>

            <!-- Agent Step 5 -->
            <div class="pt-2 flex items-center justify-between text-emerald-400 font-bold border-t border-slate-800 text-xs">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                {isEs ? '5. Audit Gate Verificado -> Listo para PR' : '5. Audit Gate Verified -> Ready for PR'}
              </span>
              <span class="text-slate-400 font-mono text-[10px]">Zero Hallucinations</span>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  function switchHeroTab(tab) {
    const cliBtn = document.getElementById('tab-cli-btn');
    const agentBtn = document.getElementById('tab-agent-btn');
    const viewCli = document.getElementById('view-cli');
    const viewAgent = document.getElementById('view-agent');

    if (tab === 'cli') {
      cliBtn.className = "px-2.5 py-1 rounded-md transition-all font-semibold bg-slate-800 text-emerald-400 shadow-xs";
      agentBtn.className = "px-2.5 py-1 rounded-md transition-all text-slate-400 hover:text-white";
      viewCli.classList.remove('hidden');
      viewAgent.classList.add('hidden');
    } else {
      agentBtn.className = "px-2.5 py-1 rounded-md transition-all font-semibold bg-slate-800 text-cyan-400 shadow-xs";
      cliBtn.className = "px-2.5 py-1 rounded-md transition-all text-slate-400 hover:text-white";
      viewAgent.classList.remove('hidden');
      viewCli.classList.add('hidden');
    }
  }
</script>

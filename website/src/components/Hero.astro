---
---

<section class="relative pt-20 pb-16 md:pt-28 md:pb-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Status badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold tracking-wide mb-8">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      Deterministic AI Agent Governance Engine
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-[1.08] mb-6">
      Eliminate uncontrolled code <br class="hidden sm:inline" />
      <span class="text-emerald-400">before</span> it reaches production.
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
      CLC Kernel forces autonomous coding agents into strict SDD specifications, verifiable TDD proofs, and automated AST architectural guardrails across 8+ programming languages.
    </p>

    <!-- Quick action bar -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-16">
      <div class="flex items-center gap-3 px-4 py-2.5 rounded-lg bg-[#0c121d] border border-white/10 font-mono text-xs sm:text-sm text-slate-200 shadow-lg">
        <span class="text-emerald-400 select-none">$</span>
        <span class="select-all">npx clckernel start</span>
        <button 
          type="button"
          onclick="navigator.clipboard.writeText('npx clckernel start'); const el=this.querySelector('.copy-label'); el.textContent='Copied!'; setTimeout(()=>el.textContent='Copy', 2000)" 
          class="ml-2 flex items-center gap-1.5 px-2.5 py-1 rounded bg-white/[0.06] hover:bg-white/[0.12] text-xs font-sans text-slate-300 transition-colors"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-label">Copy</span>
        </button>
      </div>

      <a
        href="#lifecycle"
        class="px-5 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-xs sm:text-sm transition-colors"
      >
        Explore Lifecycle →
      </a>
    </div>

    <!-- Live Governance Simulator Terminal -->
    <div class="max-w-4xl mx-auto rounded-xl terminal-window text-left overflow-hidden border border-white/10">
      <div class="bg-[#0c121d] px-4 py-3 border-b border-white/[0.08] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-[#ff5f56]/80"></div>
          <div class="w-3 h-3 rounded-full bg-[#ffbd2e]/80"></div>
          <div class="w-3 h-3 rounded-full bg-[#27c93f]/80"></div>
          <span class="ml-2 text-xs font-mono text-slate-400">audit_orchestrator.js — clckernel gate</span>
        </div>
        <div class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
          HARD GATE MODE
        </div>
      </div>

      <div class="p-5 font-mono text-xs text-slate-300 space-y-2.5 overflow-x-auto bg-[#070b12]">
        <div class="flex items-center gap-2 text-slate-400">
          <span class="text-emerald-400">➜</span> <span>node tools/audit.js</span>
        </div>
        
        <div class="text-slate-500 pt-1">
          [1/5] Scanning git-diff against active safeguard catalog...
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1 text-slate-200">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✔</span>
            <span>scan_secrets</span>
            <span class="text-slate-500 text-[10px]">0 credentials leaked</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✔</span>
            <span>check_architecture</span>
            <span class="text-slate-500 text-[10px]">Clean Architecture AST passed</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✔</span>
            <span>check_db_efficiency</span>
            <span class="text-slate-500 text-[10px]">No N+1 queries detected</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-emerald-400">✔</span>
            <span>check_scope</span>
            <span class="text-slate-500 text-[10px]">100% within authorized SDD</span>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-white/[0.08] flex items-center justify-between text-emerald-400 font-semibold text-xs">
          <span>✔ AUDIT GATE PASSED — Pre-commit authorization granted.</span>
          <span class="text-slate-500 text-[10px]">Exit Code 0</span>
        </div>
      </div>
    </div>

  </div>
</section>

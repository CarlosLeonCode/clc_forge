---
import { ui } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';

const guards = isEs ? [
  {
    name: "scan_secrets",
    lang: "Node.js y Python AST",
    category: "Seguridad",
    desc: "Escanea diffs en busca de llaves privadas, credenciales de AWS/Stripe, tokens JWT y contraseñas de BD sin falsos positivos.",
  },
  {
    name: "check_architecture",
    lang: "JS y Python AST",
    category: "Arquitectura",
    desc: "Valida los límites de capas en Clean Architecture (Dominio -> Caso de Uso -> Infraestructura) y bloquea consultas directas a BD en vistas.",
  },
  {
    name: "check_db_efficiency",
    lang: "Python AST",
    category: "Rendimiento",
    desc: "Detecta patrones de consulta N+1 en bucles y exige select_related / prefetch_related / joinedload en consultas ORM.",
  },
  {
    name: "check_responsive",
    lang: "Node.js AST",
    category: "Frontend",
    desc: "Exige diseño mobile-first, detecta anchos fijos en px (width > 400px) y exige áreas táctiles mínimas de 44x44px.",
  },
  {
    name: "check_seo",
    lang: "Node.js AST",
    category: "SEO y CWV",
    desc: "Valida OpenGraph, etiquetas GEO, jerarquía única de <h1> y marcas de prioridad LCP en imágenes principales.",
  },
  {
    name: "check_migrations",
    lang: "Python AST",
    category: "Base de Datos",
    desc: "Audita migraciones de Alembic y Django para garantizar que las operaciones sean reversibles, seguras e idempotentes.",
  },
  {
    name: "docker_guard",
    lang: "Python AST",
    category: "Infraestructura",
    desc: "Exige directivas USER no-root en Dockerfiles, bloquea secretos en ENV y requiere directivas HEALTHCHECK.",
  },
  {
    name: "check_scope",
    lang: "Python AST",
    category: "Gobernanza",
    desc: "Verifica que los diffs en git no excedan el alcance de archivos autorizado en el plan SDD local.",
  },
] : [
  {
    name: "scan_secrets",
    lang: "Node.js & Python AST",
    category: "Security",
    desc: "Scans diffs for private keys, AWS/Stripe credentials, JWT secrets, and hardcoded DB passwords with zero false positives.",
  },
  {
    name: "check_architecture",
    lang: "JS & Python AST",
    category: "Architecture",
    desc: "Validates Clean Architecture layer boundaries (Domain -> Use Case -> Infrastructure) and blocks presentation layer DB queries.",
  },
  {
    name: "check_db_efficiency",
    lang: "Python AST",
    category: "Performance",
    desc: "Detects ORM N+1 query patterns in loops and enforces select_related / prefetch_related / joinedload in query definitions.",
  },
  {
    name: "check_responsive",
    lang: "Node.js AST",
    category: "Frontend",
    desc: "Enforces mobile-first CSS, flags fixed-pixel desktop overflows (width > 400px), and requires min 44x44px touch targets.",
  },
  {
    name: "check_seo",
    lang: "Node.js AST",
    category: "SEO & CWV",
    desc: "Validates OpenGraph, GEO tags, unique <h1> hierarchy, and LCP priority tags for hero media assets.",
  },
  {
    name: "check_migrations",
    lang: "Python AST",
    category: "Database",
    desc: "Audits Alembic and Django migrations to guarantee operations are reversible, safe, and idempotent.",
  },
  {
    name: "docker_guard",
    lang: "Python AST",
    category: "Infrastructure",
    desc: "Enforces non-root USER directives in Dockerfiles, blocks ENV secrets, and requires container HEALTHCHECK.",
  },
  {
    name: "check_scope",
    lang: "Python AST",
    category: "Governance",
    desc: "Verifies that staged git diffs do not exceed the authorized file scope specified in the local SDD plan.",
  },
];
---

<section id="safeguards" class="py-20 md:py-28 border-t border-slate-200 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-600 font-semibold mb-2">{t['safeguards.kicker']}</h2>
      <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-4">
        {t['safeguards.title']}
      </p>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        {t['safeguards.desc']}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {guards.map((guard) => (
        <div class="surface-card p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-slate-900 tracking-wide">
                {guard.name}
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 font-medium">
                {guard.category}
              </span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              {guard.desc}
            </p>
          </div>
          
          <div class="pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-500">
            {isEs ? 'Motor:' : 'Engine:'} <span class="text-slate-800 font-medium">{guard.lang}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
const guards = [
  {
    name: "scan_secrets",
    lang: "Node.js & Python AST",
    category: "Security",
    desc: "Scans diffs for private keys, AWS/Stripe credentials, JWT secrets, and hardcoded DB passwords with zero false positives.",
  },
  {
    name: "check_architecture",
    lang: "JS & Python AST",
    category: "Architecture",
    desc: "Validates Clean Architecture layer boundaries (Domain -> Use Case -> Infrastructure) and blocks presentation layer DB queries.",
  },
  {
    name: "check_db_efficiency",
    lang: "Python AST",
    category: "Performance",
    desc: "Detects ORM N+1 query patterns in loops and enforces select_related / prefetch_related / joinedload in query definitions.",
  },
  {
    name: "check_responsive",
    lang: "Node.js AST",
    category: "Frontend",
    desc: "Enforces mobile-first CSS, flags fixed-pixel desktop overflows (width > 400px), and requires min 44x44px touch targets.",
  },
  {
    name: "check_seo",
    lang: "Node.js AST",
    category: "SEO & CWV",
    desc: "Validates OpenGraph, GEO tags, unique <h1> hierarchy, and LCP priority tags for hero media assets.",
  },
  {
    name: "check_migrations",
    lang: "Python AST",
    category: "Database",
    desc: "Audits Alembic and Django migrations to guarantee operations are reversible, safe, and idempotent.",
  },
  {
    name: "docker_guard",
    lang: "Python AST",
    category: "Infrastructure",
    desc: "Enforces non-root USER directives in Dockerfiles, blocks ENV secrets, and requires container HEALTHCHECK.",
  },
  {
    name: "check_scope",
    lang: "Python AST",
    category: "Governance",
    desc: "Verifies that staged git diffs do not exceed the authorized file scope specified in the local SDD plan.",
  },
];
---

<section id="safeguards" class="py-20 md:py-28 border-t border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-400 font-semibold mb-2">Deterministic Linting</h2>
      <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
        Zero-Dependency Safeguards
      </p>
      <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
        Built exclusively using native Node.js and Python AST parsers. Fast execution, zero bloated runtime npm dependencies, and deterministic rules.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {guards.map((guard) => (
        <div class="surface-card p-5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-white tracking-wide">
                {guard.name}
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/[0.06] text-emerald-400 border border-emerald-500/20">
                {guard.category}
              </span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              {guard.desc}
            </p>
          </div>
          
          <div class="pt-3 border-t border-white/[0.06] text-[11px] font-mono text-slate-500">
            Engine: <span class="text-slate-300">{guard.lang}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

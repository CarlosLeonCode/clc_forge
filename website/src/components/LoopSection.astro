---
import { ui } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';

const steps = isEs ? [
  {
    phase: "01",
    name: "Investigación y Causa Raíz",
    category: "Contexto",
    desc: "Inspecciona rutas de código, dependencias AST y trazas de error antes de editar. Prohíbe alucinaciones sin evidencia del codebase.",
    details: "Cero ediciones a ciegas. El contexto debe probarse antes de tocar archivos.",
  },
  {
    phase: "02",
    name: "Planificación Local SDD",
    category: "Arquitectura",
    desc: "Genera especificaciones locales de desarrollo guiado por specs (sdds/) con límites de alcance y contratos de API claros.",
    details: "100% local y gitignored para aislar la intención de desarrollo.",
  },
  {
    phase: "03",
    name: "Fase Roja TDD (Regresión)",
    category: "Verificación",
    desc: "Escribe primero las pruebas unitarias que fallan. El arnés registra el código de salida de fallo como prueba del defecto.",
    details: "Salida de test fallido obligatoria antes de implementar soluciones.",
  },
  {
    phase: "04",
    name: "Implementación Limpia (Verde)",
    category: "Ejecución",
    desc: "Implementa el cambio para hacer pasar la suite de pruebas respetando estrictamente el aislamiento de capas de Clean Architecture.",
    details: "Las capas de presentación no pueden consultar la base de datos directamente.",
  },
  {
    phase: "05",
    name: "Compuerta de Auditoría AST",
    category: "Salvaguardas",
    desc: "Ejecuta linters AST, escáneres de secretos, detección de N+1 y validaciones responsive antes del stage.",
    details: "Scripts deterministas sin dependencias en Node.js y Python.",
  },
  {
    phase: "06",
    name: "DoD y Pre-Commit Estricto",
    category: "Entrega",
    desc: "Los hooks de pre-commit verifican que todas las salvaguardas hayan aprobado antes de autorizar el commit en git.",
    details: "Bloquea commits no conformes automáticamente en el límite de git.",
  },
] : [
  {
    phase: "01",
    name: "Research & Root Cause",
    category: "Context",
    desc: "Inspect code paths, AST dependencies, and tracebacks before editing. Forbids AI hallucinations without codebase evidence.",
    details: "Zero blind edits. Codebase context must be proven before writing files.",
  },
  {
    phase: "02",
    name: "SDD Local Planning",
    category: "Architecture",
    desc: "Generate local, gitignored Spec-Driven Development specs (sdds/) containing clear boundaries and schema contracts.",
    details: "100% local and gitignored specs to isolate development intent.",
  },
  {
    phase: "03",
    name: "TDD Red Phase (Regression)",
    category: "Verification",
    desc: "Write failing unit tests first. The harness records the failing exit code as deterministic evidence of defect reproduction.",
    details: "Failing test output required before implementing fixes.",
  },
  {
    phase: "04",
    name: "Clean Implementation (Green)",
    category: "Execution",
    desc: "Implement the feature or fix to make the test suite pass while strictly adhering to Clean Architecture layer isolation.",
    details: "Presentation layers cannot call database models directly.",
  },
  {
    phase: "05",
    name: "Automated Audit Gate",
    category: "Guardrails",
    desc: "Execute AST linters, secret scanners, N+1 query checks, and responsive layout audits before staging files.",
    details: "Deterministic zero-dependency scripts in Node.js & Python.",
  },
  {
    phase: "06",
    name: "DoD & Pre-Commit Enforcement",
    category: "Delivery",
    desc: "Native pre-commit hooks verify that all safeguards and audit gates passed before authorizing git commits.",
    details: "Blocks non-compliant commits automatically at the git boundary.",
  },
];
---

<section id="lifecycle" class="py-20 md:py-28 border-t border-slate-200 bg-[#f8fafc]/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-600 font-semibold mb-2">{t['loop.kicker']}</h2>
      <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-4">
        {t['loop.title']}
      </p>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        {t['loop.desc']}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {steps.map((step) => (
        <div class="surface-card p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xl font-bold text-emerald-600">
                {step.phase}
              </span>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200 font-medium">
                {step.category}
              </span>
            </div>

            <h3 class="text-base font-bold text-slate-900 mb-2">
              {step.name}
            </h3>
            
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              {step.desc}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 text-[11px] font-mono text-slate-500">
            {step.details}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

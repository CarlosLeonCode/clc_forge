---
const steps = [
  {
    phase: "01",
    name: "Research & Root Cause",
    category: "Context",
    desc: "Inspect code paths, AST dependencies, and tracebacks before editing. Forbids AI hallucinations without codebase evidence.",
    details: "Zero blind edits. Codebase context must be proven before writing files.",
  },
  {
    phase: "02",
    name: "SDD Local Planning",
    category: "Architecture",
    desc: "Generate local, gitignored Spec-Driven Development specs (sdds/) containing clear boundaries and schema contracts.",
    details: "100% local and gitignored specs to isolate development intent.",
  },
  {
    phase: "03",
    name: "TDD Red Phase (Regression)",
    category: "Verification",
    desc: "Write failing unit tests first. The harness records the failing exit code as deterministic evidence of defect reproduction.",
    details: "Failing test output required before implementing fixes.",
  },
  {
    phase: "04",
    name: "Clean Implementation (Green)",
    category: "Execution",
    desc: "Implement the feature or fix to make the test suite pass while strictly adhering to Clean Architecture layer isolation.",
    details: "Presentation layers cannot call database models directly.",
  },
  {
    phase: "05",
    name: "Automated Audit Gate",
    category: "Guardrails",
    desc: "Execute AST linters, secret scanners, N+1 query checks, and responsive layout audits before staging files.",
    details: "Deterministic zero-dependency scripts in Node.js & Python.",
  },
  {
    phase: "06",
    name: "DoD & Pre-Commit Enforcement",
    category: "Delivery",
    desc: "Native pre-commit hooks verify that all safeguards and audit gates passed before authorizing git commits.",
    details: "Blocks non-compliant commits automatically at the git boundary.",
  },
];
---

<section id="lifecycle" class="py-20 md:py-28 border-t border-white/[0.06] bg-[#080d15]/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-400 font-semibold mb-2">Deterministic Workflow</h2>
      <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
        The Agent Governance Lifecycle
      </p>
      <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
        AI coding assistants should never push unverified code. CLC Kernel enforces a strict, multi-phase verification loop that stops regression and hallucination at the source.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {steps.map((step) => (
        <div class="surface-card p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xl font-bold text-emerald-400">
                {step.phase}
              </span>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-white/[0.06] text-slate-300 border border-white/10">
                {step.category}
              </span>
            </div>

            <h3 class="text-base font-bold text-white mb-2">
              {step.name}
            </h3>
            
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              {step.desc}
            </p>
          </div>

          <div class="pt-3 border-t border-white/[0.06] text-[11px] font-mono text-slate-500">
            {step.details}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

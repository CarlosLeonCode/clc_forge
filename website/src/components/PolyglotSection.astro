---
const stacks = [
  { name: "Next.js / React", ecosystem: "TypeScript", runner: "Vitest / Jest", type: "Frontend" },
  { name: "FastAPI", ecosystem: "Python", runner: "Pytest", type: "Backend" },
  { name: "Django", ecosystem: "Python", runner: "Pytest / Django Test", type: "Fullstack" },
  { name: "Astro", ecosystem: "TypeScript", runner: "Vitest / Playwright", type: "Web & Content" },
  { name: "Ruby on Rails", ecosystem: "Ruby", runner: "RSpec / Minitest", type: "Backend" },
  { name: "Golang", ecosystem: "Go", runner: "go test", type: "Microservices" },
  { name: "Rust", ecosystem: "Rust", runner: "cargo test", type: "Systems" },
  { name: "Laravel", ecosystem: "PHP", runner: "Pest / PHPUnit", type: "Fullstack" },
];

const harnesses = [
  {
    name: "Cursor / Windsurf",
    file: ".cursorrules & .cursor/rules/*.mdc",
    desc: "Direct symbolic link to authoritative repository law and layer boundaries.",
  },
  {
    name: "Google Antigravity",
    file: ".antigravity/rules.md & skills",
    desc: "Seamless synchronization of custom skills, audit gates, and execution rules.",
  },
  {
    name: "Claude Code",
    file: "CLAUDE.md",
    desc: "Strict TDD verification enforcement and mandatory AST audit gate compliance.",
  },
  {
    name: "GitHub Copilot",
    file: ".github/copilot-instructions.md",
    desc: "Consistent context injection for inline completions and chat suggestions.",
  },
];
---

<section id="ecosystems" class="py-20 md:py-28 border-t border-white/[0.06] bg-[#080d15]/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
      <div class="lg:col-span-5">
        <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-400 font-semibold mb-2">Universal Governance</h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-4">
          One Law for Every Stack
        </p>
        <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
          Regardless of your framework or language, CLC Kernel detects your project signature, installs native linters, and materializes enforceable rules for your preferred AI coding assistants.
        </p>
      </div>

      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-4 gap-3">
        {stacks.map((stack) => (
          <div class="surface-card p-4 flex flex-col justify-between min-h-[105px]">
            <div>
              <div class="font-bold text-sm text-white mb-1">{stack.name}</div>
              <div class="text-[11px] text-slate-400">{stack.ecosystem}</div>
            </div>
            <div class="text-[10px] font-mono text-emerald-400 pt-2 border-t border-white/[0.06]">
              {stack.runner}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- AI Harness Integration Grid -->
    <div>
      <h3 class="text-xs font-mono uppercase text-slate-400 font-semibold tracking-wider mb-4">
        Supported AI Agent Harnesses:
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {harnesses.map((harness) => (
          <div class="surface-card p-5">
            <div class="font-bold text-sm text-white mb-1">{harness.name}</div>
            <div class="font-mono text-[10px] text-emerald-400 mb-2">{harness.file}</div>
            <p class="text-xs text-slate-400 leading-relaxed">{harness.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

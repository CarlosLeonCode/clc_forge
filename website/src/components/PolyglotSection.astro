---
const stacks = [
  { name: "Next.js & React", type: "Frontend", status: "Supported", icon: "⚛️" },
  { name: "FastAPI", type: "Python Backend", status: "Supported", icon: "⚡" },
  { name: "Django", type: "Python Fullstack", status: "Supported", icon: "🎸" },
  { name: "Astro", type: "Web & Content", status: "Supported", icon: "🚀" },
  { name: "Ruby on Rails", type: "Ruby Backend", status: "Supported", icon: "💎" },
  { name: "Golang", type: "Go Service", status: "Supported", icon: "🐹" },
  { name: "Rust", type: "Native Systems", status: "Supported", icon: "🦀" },
  { name: "Laravel", type: "PHP Fullstack", status: "Supported", icon: "🐘" },
];

const companions = [
  { name: "Cursor / Windsurf", desc: "Native .cursorrules & .cursor/rules MDC symlinks" },
  { name: "Google Antigravity", desc: "Native skills & rules.md synchronization" },
  { name: "Claude Code", desc: "Authoritative CLAUDE.md law integration" },
  { name: "GitHub Copilot", desc: "copilot-instructions.md standard generation" },
];
---

<section id="polyglot" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-400 font-bold mb-3">Universal Compatibility</h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mb-6">
          One Governance Standard for Every Tech Stack
        </p>
        <p class="text-slate-400 text-base leading-relaxed mb-8">
          Whether you build with Python, TypeScript, Go, Ruby, PHP, or Rust, CLC Kernel detects your project signature and materializes native hooks, test configurations, and AST linters automatically.
        </p>

        <div class="space-y-3">
          <h4 class="text-xs font-mono uppercase text-slate-400 font-semibold tracking-wider">AI IDE & Harness Support:</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {companions.map((comp) => (
              <div class="p-3 rounded-lg bg-white/5 border border-white/5">
                <div class="font-bold text-xs text-slate-200">{comp.name}</div>
                <div class="text-[11px] text-slate-400">{comp.desc}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {stacks.map((stack) => (
            <div class="p-4 rounded-xl glass-card text-center flex flex-col items-center justify-center min-h-[120px]">
              <span class="text-3xl mb-2">{stack.icon}</span>
              <span class="font-bold text-sm text-slate-200">{stack.name}</span>
              <span class="text-[10px] text-emerald-400 font-mono mt-1">{stack.type}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

---
import { ui } from '../i18n/ui.js';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const isEs = lang === 'es';

const stacks = [
  { name: "Next.js / React", ecosystem: "TypeScript", runner: "Vitest / Jest", type: isEs ? "Frontend" : "Frontend" },
  { name: "FastAPI", ecosystem: "Python", runner: "Pytest", type: isEs ? "Backend" : "Backend" },
  { name: "Django", ecosystem: "Python", runner: "Pytest / Django Test", type: isEs ? "Fullstack" : "Fullstack" },
  { name: "Astro", ecosystem: "TypeScript", runner: "Vitest / Playwright", type: isEs ? "Web y Contenido" : "Web & Content" },
  { name: "Ruby on Rails", ecosystem: "Ruby", runner: "RSpec / Minitest", type: isEs ? "Backend" : "Backend" },
  { name: "Golang", ecosystem: "Go", runner: "go test", type: isEs ? "Microservicios" : "Microservices" },
  { name: "Rust", ecosystem: "Rust", runner: "cargo test", type: isEs ? "Sistemas" : "Systems" },
  { name: "Laravel", ecosystem: "PHP", runner: "Pest / PHPUnit", type: isEs ? "Fullstack" : "Fullstack" },
];

const harnesses = isEs ? [
  {
    name: "Cursor / Windsurf",
    file: ".cursorrules y .cursor/rules/*.mdc",
    desc: "Enlace simbólico directo a la ley de arquitectura y límites de capas del repositorio.",
  },
  {
    name: "Google Antigravity",
    file: ".antigravity/rules.md y skills",
    desc: "Sincronización fluida de skills personalizados, compuertas de auditoría y reglas de ejecución.",
  },
  {
    name: "Claude Code",
    file: "CLAUDE.md",
    desc: "Exigencia estricta de verificación TDD y compuertas AST obligatorias antes de comitear.",
  },
  {
    name: "GitHub Copilot",
    file: ".github/copilot-instructions.md",
    desc: "Inyección de contexto consistente para completado de código y sugerencias en chat.",
  },
] : [
  {
    name: "Cursor / Windsurf",
    file: ".cursorrules & .cursor/rules/*.mdc",
    desc: "Direct symbolic link to authoritative repository law and layer boundaries.",
  },
  {
    name: "Google Antigravity",
    file: ".antigravity/rules.md & skills",
    desc: "Seamless synchronization of custom skills, audit gates, and execution rules.",
  },
  {
    name: "Claude Code",
    file: "CLAUDE.md",
    desc: "Strict TDD verification enforcement and mandatory AST audit gate compliance.",
  },
  {
    name: "GitHub Copilot",
    file: ".github/copilot-instructions.md",
    desc: "Consistent context injection for inline completions and chat suggestions.",
  },
];
---

<section id="ecosystems" class="py-20 md:py-28 border-t border-slate-200 bg-[#f8fafc]/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
      <div class="lg:col-span-5">
        <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-600 font-semibold mb-2">{t['polyglot.kicker']}</h2>
        <p class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mb-4">
          {t['polyglot.title']}
        </p>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          {t['polyglot.desc']}
        </p>
      </div>

      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-4 gap-3">
        {stacks.map((stack) => (
          <div class="surface-card p-4 flex flex-col justify-between min-h-[105px]">
            <div>
              <div class="font-bold text-sm text-slate-900 mb-1">{stack.name}</div>
              <div class="text-[11px] text-slate-500">{stack.ecosystem}</div>
            </div>
            <div class="text-[10px] font-mono text-emerald-700 font-medium pt-2 border-t border-slate-100">
              {stack.runner}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- AI Harness Integration Grid -->
    <div>
      <h3 class="text-xs font-mono uppercase text-slate-500 font-semibold tracking-wider mb-4">
        {t['polyglot.harnessTitle']}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {harnesses.map((harness) => (
          <div class="surface-card p-5">
            <div class="font-bold text-sm text-slate-900 mb-1">{harness.name}</div>
            <div class="font-mono text-[10px] text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 inline-block mb-2 font-medium">{harness.file}</div>
            <p class="text-xs text-slate-600 leading-relaxed">{harness.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

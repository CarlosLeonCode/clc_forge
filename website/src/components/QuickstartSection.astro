---
const steps = [
  {
    step: "1",
    title: "Interactive Initialization",
    desc: "Auto-detects your ecosystem, configures .clckernel.yaml, and links agent rules.",
    cmd: "npx clckernel start",
  },
  {
    step: "2",
    title: "Environment & Health Audit",
    desc: "Validates hook installations, test runner availability, and AST syntax parsing.",
    cmd: "npx clckernel doctor",
  },
  {
    step: "3",
    title: "Manual Audit Gate Execution",
    desc: "Runs multi-guard checks against local git diffs before staging changes.",
    cmd: "node tools/audit.js",
  },
];
---

<section id="quickstart" class="py-20 md:py-28 border-t border-slate-200 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-600 font-semibold mb-2">Instant Setup</h2>
    <p class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-4">
      Initialize Your Governance Harness
    </p>
    <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto mb-12">
      Zero heavy dependencies. Run the CLI in your project root to provision enforceable agent guardrails immediately.
    </p>

    <div class="space-y-4 text-left">
      {steps.map((s) => (
        <div class="surface-card p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="w-6 h-6 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold shrink-0 mt-0.5">
              {s.step}
            </span>
            <div>
              <div class="text-sm font-bold text-slate-900 mb-0.5">{s.title}</div>
              <div class="text-xs text-slate-600">{s.desc}</div>
            </div>
          </div>

          <div class="flex items-center gap-2 bg-slate-900 px-3 py-2 rounded-lg border border-slate-800 font-mono text-xs text-slate-100 shrink-0 shadow-sm">
            <span>{s.cmd}</span>
            <button
              type="button"
              onclick={`navigator.clipboard.writeText('${s.cmd}'); const el=this; el.textContent='Copied!'; setTimeout(()=>el.textContent='Copy', 2000)`}
              class="ml-2 text-[11px] font-sans px-2.5 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
            >
              Copy
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

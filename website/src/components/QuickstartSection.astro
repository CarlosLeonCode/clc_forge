---
---

<section id="quickstart" class="py-24 relative bg-slate-950/60 border-t border-white/5">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-xs uppercase font-mono tracking-widest text-emerald-400 font-bold mb-3">Instant Provisioning</h2>
    <p class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
      Initialize Your Governance Harness in Seconds
    </p>
    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto mb-12">
      Run CLC Kernel in your project root. It will auto-detect your stack, generate git hooks, install zero-dependency linters, and link your agent instructions.
    </p>

    <div class="max-w-2xl mx-auto space-y-4 text-left">
      <!-- Step 1 -->
      <div class="p-4 rounded-xl glass-card border border-white/10 flex items-start gap-4">
        <span class="w-7 h-7 rounded-full bg-emerald-500/20 text-emerald-400 font-mono text-xs flex items-center justify-center font-bold shrink-0 mt-0.5">1</span>
        <div class="w-full">
          <div class="text-xs font-mono text-slate-400 mb-1">Interactive Initialization</div>
          <div class="bg-slate-950 p-3 rounded-lg font-mono text-xs text-slate-200 flex items-center justify-between">
            <span>npx clckernel start</span>
            <button onclick="navigator.clipboard.writeText('npx clckernel start')" class="text-[11px] text-slate-400 hover:text-white px-2 py-0.5 rounded bg-white/5">Copy</button>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="p-4 rounded-xl glass-card border border-white/10 flex items-start gap-4">
        <span class="w-7 h-7 rounded-full bg-cyan-500/20 text-cyan-400 font-mono text-xs flex items-center justify-center font-bold shrink-0 mt-0.5">2</span>
        <div class="w-full">
          <div class="text-xs font-mono text-slate-400 mb-1">Verify Environment Health</div>
          <div class="bg-slate-950 p-3 rounded-lg font-mono text-xs text-slate-200 flex items-center justify-between">
            <span>npx clckernel doctor</span>
            <button onclick="navigator.clipboard.writeText('npx clckernel doctor')" class="text-[11px] text-slate-400 hover:text-white px-2 py-0.5 rounded bg-white/5">Copy</button>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="p-4 rounded-xl glass-card border border-white/10 flex items-start gap-4">
        <span class="w-7 h-7 rounded-full bg-indigo-500/20 text-indigo-400 font-mono text-xs flex items-center justify-center font-bold shrink-0 mt-0.5">3</span>
        <div class="w-full">
          <div class="text-xs font-mono text-slate-400 mb-1">Run Full Quality Audit Gate</div>
          <div class="bg-slate-950 p-3 rounded-lg font-mono text-xs text-slate-200 flex items-center justify-between">
            <span>node tools/audit.js # or python tools/audit.py</span>
            <button onclick="navigator.clipboard.writeText('node tools/audit.js')" class="text-[11px] text-slate-400 hover:text-white px-2 py-0.5 rounded bg-white/5">Copy</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
